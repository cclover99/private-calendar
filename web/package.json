{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:frontend",
    "dev:server": "bun --hot server.ts",
    "dev:frontend": "bun build ./src/frontend.tsx --outdir=dist --target=browser --sourcemap=linked --watch",
    "build": "bun build ./src/frontend.tsx --outdir=dist --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*' && cp -R ./public/* ./dist/",
    "start": "bun server.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "openpgp": "^6.3.1",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "resend": "^6.22.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "7.10.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
